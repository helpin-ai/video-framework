{
  "name": "helpin-video-framework",
  "private": true,
  "type": "module",
  "description": "Frame-exact HTML video framework for Helpin launch and product reels",
  "scripts": {
    "new": "node bin/new-video.mjs",
    "preview": "node bin/preview.mjs",
    "render": "node bin/render.mjs",
    "sheet": "node bin/render.mjs --sheet 12",
    "audio": "node --env-file=.env bin/audio.mjs",
    "inspect": "node bin/inspect.mjs",
    "splice": "node bin/splice.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@fontsource/instrument-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "ffmpeg-static": "^5.3.0",
    "playwright": "^1.59.1"
  },
  "allowScripts": {
    "ffmpeg-static@5.3.0": true
  }
}
